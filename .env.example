APP_ORIGIN=http://localhost:8080
HTTP_PORT=8080
DEPLOY_ENV=local
# Use at least 32 random hexadecimal characters, URL-safe.
DB_PASSWORD=
SESSION_SECRET=
ADMIN_USERNAME=owner
# At least 12 characters. Existing administrator is never overwritten.
ADMIN_PASSWORD=
STORAGE_DRIVER=local
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# Optional image registry settings for scripts/update-server.sh.
# Copy the exact public registry host from ACR > Access Credentials.
# Personal Edition has multiple endpoint formats; copy rather than type it.
# ACR_REGISTRY=crpi-xxxx.cn-hangzhou.personal.cr.aliyuncs.com
# Host only: do not append /namespace/repository.
# ACR_NAMESPACE=your-namespace
# IMAGE_TAG defaults to latest for ACR Personal Edition build rules.
# Production: APP_ORIGIN=https://your-domain, DEPLOY_ENV=production, HTTP_PORT=80
# COMPOSE_FILE=compose.yaml:compose.https.yaml (Ubuntu separator)
# TLS_CERT_DIR=/absolute/path/to/certs (fullchain.pem + privkey.pem)
