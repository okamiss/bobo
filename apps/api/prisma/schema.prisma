generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String     @id @default(uuid())
  username     String     @unique
  displayName  String
  passwordHash String
  role         String     @default("member")
  active       Boolean    @default(true)
  // When this account agreed that writing help may send content to the model.
  aiConsentAt  DateTime?
  sessions     Session[]
  entries      Entry[]
  auditLogs    AuditLog[]
  aiUsage      AiUsage[]
  aiChats      AiConversation[]
}

// One row per writing-help call, used for the per-account daily quota and to
// keep a record of what the feature costs.
model AiUsage {
  id        String   @id @default(uuid())
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  kind      String
  model     String
  tokensIn  Int      @default(0)
  tokensOut Int      @default(0)
  ms        Int      @default(0)
  createdAt DateTime @default(now())

  @@index([adminId, createdAt])
}

// Who changed shared site content (profile, covers, albums, growth, health) and how.
// actorName keeps the display name at the time, even if the account changes.
model AuditLog {
  id        String   @id @default(uuid())
  adminId   String?
  admin     Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  actorName String
  action    String
  summary   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Session {
  id        String   @id
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
}

model Profile {
  id                Int     @id @default(1)
  siteName          String  @default("啵啵的小日子")
  name              String  @default("啵啵")
  breed             String  @default("雪纳瑞")
  birthday          String?
  homeDate          String?
  intro             String  @default("把每一次长大，都好好收藏。")
  personality       String  @default("")
  hobbies           String  @default("")
  coverMediaId      String?
  aboutCoverMediaId String?
  growthPublic      Boolean @default(false)
}

// One growth measurement per day; weight in kg, shoulder height in cm.
model Measurement {
  id         String   @id @default(uuid())
  measuredOn String   @unique
  weight     Float?
  height     Float?
  note       String   @default("")
  createdAt  DateTime @default(now())
}

// Private family health history and optional next-care reminder.
model HealthRecord {
  id         String   @id @default(uuid())
  kind       String
  occurredOn String
  nextDueOn  String?
  note       String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([nextDueOn])
  @@index([occurredOn])
}

model Entry {
  id           String    @id @default(uuid())
  title        String
  occurredOn   String
  kind         String    @default("daily")
  body         String    @default("")
  tags         String[]  @default([])
  status       String    @default("draft")
  visibility   String    @default("private")
  milestone    Boolean   @default(false)
  featured     Boolean   @default(false)
  coverMediaId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  publishedAt  DateTime?
  authorId     String?
  author       Admin?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  media        Media[]

  @@index([status, visibility, occurredOn, id])
  @@index([authorId])
}

model Tag {
  name      String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Media {
  id        String      @id @default(uuid())
  // Null for site images (page covers) uploaded outside of any story.
  entryId   String?
  entry     Entry?      @relation(fields: [entryId], references: [id], onDelete: Cascade)
  name      String
  mime      String
  size      Int
  kind      String
  state     String      @default("pending")
  attached  Boolean     @default(false)
  key       String      @unique
  width     Int?
  height    Int?
  duration  Float?
  caption   String      @default("")
  position  Int         @default(0)
  createdAt DateTime    @default(now())
  items     AlbumItem[]
}

model Album {
  id           String      @id @default(uuid())
  title        String
  description  String      @default("")
  visibility   String      @default("private")
  coverMediaId String?
  createdAt    DateTime    @default(now())
  items        AlbumItem[]
}

model AlbumItem {
  albumId  String
  mediaId  String
  position Int    @default(0)
  album    Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)
  media    Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([albumId, mediaId])
}

// Chat with the site. Conversations belong to one account: family members
// share the same facts about Bobo but never see each other's chats.
model AiConversation {
  id        String      @id @default(uuid())
  adminId   String
  admin     Admin       @relation(fields: [adminId], references: [id], onDelete: Cascade)
  title     String      @default("新的聊天")
  messages  AiMessage[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([adminId, updatedAt])
}

model AiMessage {
  id             String         @id @default(uuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  // Stories and records the answer was built from, as [{ id, title, ... }].
  sources        Json           @default("[]")
  model          String         @default("")
  tokensIn       Int            @default(0)
  tokensOut      Int            @default(0)
  ms             Int            @default(0)
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
}
